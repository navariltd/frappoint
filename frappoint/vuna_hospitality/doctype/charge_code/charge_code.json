   "label": "Fixed Item",
   "options": "Item",
   "depends_on": "eval:!['Payment','Deposit'].includes(doc.transaction_type)",
   "description": "Only for codes that are always the same thing, such as ROOM or NOSHOW. This Item supplies the income account and Item Tax Template. Leave empty to cover the whole Item Group."
  },
  {
   "fieldname": "item_group",
   "fieldtype": "Link",
   "label": "Covers Item Group",
   "options": "Item Group",
   "in_list_view": 1,
   "in_standard_filter": 1,
   "description": "Every Item in this group (and its sub-groups) posts with this code, so a new Item needs no setup. The nearest group wins when several codes cover an Item.",
   "mandatory_depends_on": "eval:['Revenue','Allowance'].includes(doc.transaction_type) && !doc.item",
   "depends_on": "eval:!['Payment','Deposit'].includes(doc.transaction_type)"
  },
  {
   "fieldname": "mode_of_payment",
   "fieldtype": "Link",
   "label": "Mode of Payment",
   "options": "Mode of Payment",
   "mandatory_depends_on": "eval:['Payment','Deposit'].includes(doc.transaction_type)",
