   "fieldname": "column_break_acc",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "accounting_mode",
   "fieldtype": "Select",
   "label": "Accounting Mode",
   "options": "Deferred to Folio Invoice\nExternally Accounted",
   "default": "Deferred to Folio Invoice",
   "description": "Deferred: revenue reaches the ledger when the folio is invoiced. Externally accounted: another document (e.g. a POS invoice) already recorded it, so the folio must not invoice it again."
