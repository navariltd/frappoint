  },
  {
   "fieldname": "deposit_value",
   "fieldtype": "Float",
   "label": "Deposit Value",
   "depends_on": "eval:['Percentage of Stay','Fixed Amount'].includes(doc.deposit_type)"
  },
  {
   "fieldname": "column_break_dep",
